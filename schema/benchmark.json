{
    "$schema": "http://json-schema.org/schema#",
    "$id": "benchmark.json#",
    "type": "object",
    "properties": {
        "impl": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+$"
        },
        "param": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+$"
        },
        "comment": {
            "type": "string"
        },
        "links": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "$comment": "Links to additional resources. Use `sources` to denote where the data is from."
        },
        "sources": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "$comment": "Source of the data specified here. Use only if it differs from the overall data source."
        },
        "platform": {
            "type": "string",
            "enum": [
                "desktop",
                "arm-m4",
                "arm-application",
                "fpga",
                "other"
            ],
            "$comment": "Normalized platform family. Detail (exact processor name, frequency, OS, compiler, compilation options, ...) belongs in the free-text `platform comment`."
        },
        "platform comment": {
            "type": "string"
        },
        "timings": {
            "type":"object",
            "properties": {
                "gen": {
                    "type": "number"
                },
                "enc|sign": {
                    "type": "number"
                },
                "dec|vrfy": {
                    "type": "number"
                },
                "unit": {
                    "type": "string",
                    "enum": [
                        "cycles"
                    ],
                    "$comment": "All timings are cycle counts."
                },
                "comment": {
                    "type": "string"
                }
            },
            "required": [
                "unit",
                "gen",
                "enc|sign",
                "dec|vrfy"

            ],
            "additionalProperties": false
        },
        "memory requirements": {
            "type": "object",
            "properties": {
                "gen": {
                    "type": "integer"
                },
                "enc|sign": {
                    "type": "integer"
                },
                "dec|vrfy": {
                    "type": "integer"
                },
                "comment": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "required": [
        "impl",
        "param"
    ]
}
